# Kopieren nach .env und anpassen. Alle Variablen sind optional.

# LLM in Ollama (z. B. llama3.1:8b, mistral:7b, llama3.2:3b für wenig RAM)
LLM_MODEL=llama3.1:8b
RAG_PORT=8000

# Schwärzung
# RAG_PII_ENTITIES=["PERSON","EMAIL_ADDRESS","PHONE_NUMBER","IBAN_CODE","CREDIT_CARD","IP_ADDRESS","DE_ADDRESS","DE_TAX_ID","DE_SOCIAL_SECURITY"]
# RAG_PII_SCORE_THRESHOLD=0.35
# RAG_PII_ALLOW_LIST=["Beispiel GmbH"]
# RAG_REDACT_QUERIES=true

# Retrieval
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=150
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.77

# LLM
# RAG_LLM_TEMPERATURE=0.1
# RAG_LLM_NUM_CTX=8192
